# Public Polygon mainnet endpoints from Polygon docs. For production, replace
# these with a dedicated provider endpoint if public rate limits become an issue.
POLYGON_RPC_URL=https://polygon.drpc.org
POLYGON_WS_URL=wss://polygon.drpc.org

# Polymarket market-data WebSocket. This is not the on-chain log source, but it
# is useful for later market data and mark-price enrichment.
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_US_API_URL=https://api.polymarket.us
POLYMARKET_US_GATEWAY_URL=https://gateway.polymarket.us
APP_HOST=127.0.0.1
APP_PORT=8789
DATABASE_URL=sqlite:///data/polymarket-copy-trading.sqlite3
LIVE_DATABASE_URL=sqlite:///data/polymarket-copy-trading-live.sqlite3
CONFIG_PATH=config.yaml

# Required only when mode.trading_mode=live.
# Create these in the Polymarket US developer portal, then validate with:
# python scripts/validate_polymarket_us_credentials.py --env-file .env --json
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Required for the live execution gateway. Keep this private on Tailscale/VPS.
EXECUTION_GATEWAY_AUTH_SECRET=
EXECUTION_GATEWAY_HOST=127.0.0.1
EXECUTION_GATEWAY_PORT=8791
EXECUTION_GATEWAY_RECEIPT_DB=data/execution_gateway_receipts.sqlite3
EXECUTION_GATEWAY_EXECUTION_ENABLED=false
